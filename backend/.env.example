# Copy to .env and fill in. Never commit the filled file — keys stay out of git.

# ── AvalAI (primary provider) ────────────────────────────────────────────────
# One OpenAI-compatible endpoint serving BOTH chat and embeddings, reachable from
# Iranian infrastructure without a proxy. Get a key at https://avalai.ir
# This single key is what turns on dense retrieval; without it the app runs BM25-only.
AVALAI_API_KEY=
AVALAI_BASE_URL=https://api.avalai.ir/v1

# The chat model. One model answers for everyone; only a superuser changes it, from the
# admin settings screen. This value seeds that setting the first time the database is
# created and is never read for it again — after that the panel is the only way.
#
# MUST be one of the eight ids in ChatModel (app/shared/enums.py) — that enum is the
# server-side allowlist, checked on write and again on read. Anything else here logs a
# warning at boot and silently degrades to gpt-5-mini rather than booting with an id the
# provider rejects. All eight are checked against the live provider by
# `../.venv/bin/python -m tests.test_model_allowlist`.
#
# Cost below is USD per 1,000 grounded turns, computed from the provider's own published
# rates and a MEASURED turn (2694 input + 251 output tokens). RAG turns are input-heavy, so
# the input rate dominates. Cheapest first:
#   gpt-5-nano        $0.24  cheap    — fine for short, everyday questions
#   gpt-4.1-nano      $0.37  cheap    — very cheap and fast
#   gpt-4o-mini       $0.55  cheap    — older generation, still solid
#   gpt-5-mini        $1.18  balanced — newer AND cheaper than 4.1-mini (default)
#   gemini-2.5-flash  $1.44  balanced — strong Persian, large context
#   gpt-4.1-mini      $1.48  balanced — reliable tool calling
#   claude-haiku-4-5  $3.95  pricey   — excellent instruction following
#   gpt-4.1           $7.40  pricey   — 5x the default; rarely worth it here
MODEL_PRIMARY=gpt-5-mini

# ── Embeddings ───────────────────────────────────────────────────────────────
# MUST match what built data/embeddings.npz — ingest.py and the app both read these two
# variables, and the app refuses a matrix whose width disagrees with EMBED_DIM.
# Ids below were verified against the live provider model list, not guessed from docs:
#   text-embedding-3-small       1536  cheap, solid (default, in use)
#   text-embedding-3-large       3072  better, pricier
#   cohere.embed-multilingual-v3 1024  Cohere multilingual, strong on Persian
#   gemini-embedding-001          768  Google, configurable width
# Note only text-embedding-3-* accept an explicit `dimensions` value; for the others set
# EMBED_DIM to that model's native width or the app's guard will reject the matrix.
# Changing either value means regenerating the corpus:
#   AVALAI_API_KEY=<key> ../.venv/bin/python ingest/ingest.py --resume
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536

# ── Optional chat fallbacks ──────────────────────────────────────────────────
# Tried only after AvalAI fails. Neither is used for embeddings. Leave empty to skip.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
MODEL_FALLBACK=google/gemini-2.5-flash

# ── App ──────────────────────────────────────────────────────────────────────
# CORS: comma-separated panel origins. Add the deployed panel URL before going live.
ALLOWED_ORIGINS=http://localhost:3000

# SQLite file. On Liara this must be a RELATIVE path inside the mounted disk.
# liara.json mounts the "data" disk to `storage`, so leave this as-is in production —
# an absolute path would land on the ephemeral container filesystem and lose every
# conversation on the next deploy.
DATABASE_PATH=./storage/app.db
# Data directory — holds chunks.jsonl and the optional embeddings.npz.
DATA_DIR=./data

# Automatic doc search plus token-by-token answers. Set false to turn both off.
AGENT_MODE=true
# Model reasoning depth — GPT-5 family only; every other model rejects the parameter.
# Measured on this corpus (AvalAI, gpt-5-mini): minimal ~4.5s and zero reasoning tokens,
# low ~6.2s and 192 tokens, medium (the model's own default) ~10.7s and 640 tokens — and a
# chat answer calls the model two to three times, so this number is multiplied into the
# latency. The docs are in front of the model before this stage, so deep reasoning adds
# little. Empty = do not send the parameter at all.
REASONING_EFFORT=low

STREAM_ENABLED=true

# ── Fallback models, time and cost caps ─────────────────────────────────────
# If a model does not deliver, the assistant silently moves to the next one and the user
# never learns it happened. "Does not deliver" means: it errored, returned empty text, never
# reached a grounded answer, or tried to say "I have no access / I hit a limit". The next
# model is handed the documents the previous one already fetched, so it does not start over.
#
# The order is cross-family on purpose: a failure that traps one model usually does not trap
# one from a different vendor. Any unrecognised id is dropped silently.
AGENT_MODEL_LADDER=gpt-5-mini,claude-haiku-4-5,gpt-4.1-mini
# How many times the first model may search the docs.
AGENT_TOOL_ROUNDS=3
# How many times later models may. Fewer, because the previous model's docs are still there.
AGENT_RETRY_TOOL_ROUNDS=1
# How many models one question may cost, including the primary one.
AGENT_MAX_MODEL_ATTEMPTS=3
# Wall-clock cap for one answer (seconds). Checked before each call, never mid-sentence.
AGENT_TURN_BUDGET_SECONDS=120
# Total model calls for one answer, across every model tried.
AGENT_MAX_LLM_CALLS=8
# Turning this off means only the primary model is ever tried.
AGENT_ESCALATION=true
# Per-call timeout (seconds). Below the turn budget, so one stuck provider cannot eat the
# whole answer's time.
LLM_ATTEMPT_TIMEOUT_SECONDS=45

# ── Panel authentication ────────────────────────────────────────────────────
# Session cookie signing key. Random, at least 32 characters:  openssl rand -hex 32
# Leave it empty and NOBODY can sign in — the whole product, admin surface included, stays
# shut. Empty means locked out, not wide open. With COOKIE_SECURE=true and this empty, the
# app deliberately refuses to start.
AUTH_SECRET=
# Across two liara.run domains these two values are the only correct state, not a taste:
#   COOKIE_SECURE=true  and  COOKIE_SAMESITE=none
# liara.run is on the Public Suffix List, so the panel and the API count as two separate
# SITES and the browser never sends a SameSite=lax cookie at all. The invalid pair (none
# without secure) makes the browser drop the cookie silently; the app refuses to start on it
# so the fault reads as a configuration error rather than "the session is broken".
# On localhost the values below are the correct ones (different port, same site).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# A superuser is created on the first boot only, and only while no user exists at all.
# Changing the password here does NOT change the password of an account already created.
# Do not unset it after the first run either: it is inert while any user exists, and it is
# the only recovery path if the disk is lost — with public registration, the first person to
# sign up waits in the approval queue and there is nobody to approve them.
# Minimum 12 characters, or no account is created (the refusal is logged).
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=

# Hosts that must NEVER be reached through a local HTTP/SOCKS proxy, comma-separated.
# Merged into the process-wide NO_PROXY at startup, because httpx (trust_env=True) reads
# the environment, not this file. AvalAI is reachable directly from Iranian networks;
# measured here, the same payload-free request is ~10x slower through a local proxy and
# hangs outright about one time in five — two 60s LLM attempts, i.e. the ~124s failures in
# the log. The fallback providers are exactly what a local proxy exists for and stay
# proxied. Inert in production, where there is no proxy. Empty disables the bypass.
NO_PROXY_HOSTS=api.avalai.ir

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
